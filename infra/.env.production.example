APP_NAME=Task Mall
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Asia/Shanghai
APP_KEY=base64:replace-with-generated-key
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_IDENTITY_HASH_KEY=replace-with-a-different-random-secret
ADMIN_AUTH_JWT_SECRET=replace-with-another-random-secret
ADMIN_AUTH_HASH_KEY=replace-with-another-hash-secret
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=task_mall
DB_USERNAME=task_mall
DB_PASSWORD=replace-with-secret
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-secret
MONITORING_METRICS_TOKEN=replace-with-at-least-32-random-characters
NOTIFICATION_EXTERNAL_DRIVER=webhook
NOTIFICATION_WEBHOOK_ENDPOINT=https://messages.example.com/send
NOTIFICATION_WEBHOOK_TOKEN=replace-with-random-notification-token
CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
