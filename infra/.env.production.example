WECHAT_PAYMENT_PRIVATE_KEY_PATH=/run/secrets/wechat_merchant_key
WECHAT_PAYMENT_API_V3_KEY=
WECHAT_PAYMENT_PLATFORM_CERT_FILE=/opt/task-mall/shared/secrets/wechat_platform_cert.pem
WECHAT_PAYMENT_PLATFORM_CERT_PATH=/run/secrets/wechat_platform_cert
WECHAT_PAYMENT_NOTIFY_URL=https://example.com/api/v1/payment-notifications/wechat
