  "apps": {
    "api": {
      "path": "apps/api",
      "stack": "Laravel（PHP 8+），模块在 app/Modules/*，路由 routes/api.php",
      "artisan": "php artisan"
    },
    "user-app": {
      "path": "apps/user-app",
      "stack": "uni-app + Vue3 + TypeScript + Vite + Pinia",
      "node": ">=24 <25",
      "mpWeixinDist": "apps/user-app/dist/dev/mp-weixin",
      "note": "无原生 tabBar，底部导航用自定义组件 src/components/AppTabBar.vue"
    },
    "admin-web": {
      "path": "apps/admin-web",
      "stack": "React + Vite + TypeScript"
    }
  },
  "ports": {
    "local": {
      "api_artisanServe": "8000（http://127.0.0.1:8000）",
      "postgres": "5432",
      "redis": "6379",
      "minio_api": "9000",
      "minio_console": "9001",
      "admin_web_vite": "5173（vite 默认）",
      "design_preview_history": "8902/8903/8905（设计稿本地预览，按需启动）"
    },
    "production": {
      "nginx_gateway": "8080（HTTP_PORT，仅绑 127.0.0.1，由宝塔反代到外网域名）",
      "reverb_websocket": "8081（REVERB_PORT，容器内 8080，nginx 路径 /app/ 反代）"
    }
  },
  "docker": {
    "localComposeFile": "infra/compose.yaml",
    "localProjectName": "task-mall-local",
    "localServices": ["postgres", "redis", "minio", "minio-init"],
    "productionComposeFile": "infra/compose.production.yaml",
    "productionProjectName": "task-mall-production",
    "productionServices": ["api", "queue", "scheduler", "reverb", "nginx", "postgres", "redis"],
    "productionContainerNames": {
      "api": "task-mall-production-api-1",
      "queue": "task-mall-production-queue-1",
      "scheduler": "task-mall-production-scheduler-1",
      "reverb": "task-mall-production-reverb-1",
      "nginx": "task-mall-production-nginx-1"
    },
    "note": "本机终端 docker 不在 PATH 时需用完整路径或在 Docker Desktop 环境中执行"
  },
  "commands": {
    "infra_up": "docker compose -f infra/compose.yaml up -d",
    "api_install": "composer install（在 apps/api）",
    "api_env": "复制 apps/api/.env.example 为 apps/api/.env 并按需修改；php artisan key:generate",
    "migrate": "php artisan migrate",
    "seed_base": "php artisan db:seed",
    "seed_demo": "php artisan db:seed --class=DemoDataSeeder（仅 local/testing 环境）",
    "seed_icons": "php artisan db:seed --class=IconConfigSeeder --force",
    "serve": "php artisan serve（在 apps/api）",
    "userapp_install": "npm install（在 apps/user-app）",
    "userapp_dev_weixin": "npm run dev:mp-weixin",
    "userapp_build_weixin": "npm run build:mp-weixin",
    "userapp_typecheck": "npx vue-tsc --noEmit -p tsconfig.json",
    "userapp_unit": "npm run test:unit",
    "admin_install": "npm install（在 apps/admin-web）",
    "admin_dev": "npm run dev",
    "prod_exec_noninteractive": "docker exec task-mall-production-api-1 php artisan <命令>（不要加 -it，宝塔终端会挂起）"
  },
