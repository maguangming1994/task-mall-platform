OPERATOR_ENTITY_NAME=
CUSTOMER_SERVICE_CONTACT=
PRIVACY_CONTACT=
LEGAL_DOCUMENTS_APPROVED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
MONITORING_METRICS_TOKEN=
SLOW_REQUEST_MS=500
READINESS_CACHE_TTL_SECONDS=5
PENDING_DELIVERY_GRACE_MINUTES=15
NOTIFICATION_EXTERNAL_DRIVER=local
NOTIFICATION_WEBHOOK_ENDPOINT=
NOTIFICATION_WEBHOOK_TOKEN=
