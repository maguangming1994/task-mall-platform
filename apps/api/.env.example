APP_NAME="Task Mall API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# 用户端 H5 地址：转发内容在没有小程序 URL Link 时用于生成帖子链接
USER_H5_URL=http://127.0.0.1:5173
APP_TIMEZONE=Asia/Shanghai
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

AUTH_TOKEN_ISSUER=task-mall-api
AUTH_ACCESS_TTL_SECONDS=7200
AUTH_REFRESH_TTL_DAYS=30
AUTH_MAX_ACTIVE_DEVICES=5
AUTH_DEVICE_LIMIT_STRATEGY=revoke_oldest
AUTH_JWT_SECRET=
AUTH_IDENTITY_HASH_KEY=
ADMIN_AUTH_JWT_SECRET=
ADMIN_AUTH_HASH_KEY=
ADMIN_AUTH_ACCESS_TTL_SECONDS=3600
ADMIN_AUTH_REFRESH_TTL_DAYS=7
ADMIN_AUTH_IDLE_TTL_SECONDS=1800
ADMIN_AUTH_REMEMBER_REFRESH_TTL_DAYS=30
ADMIN_AUTH_REMEMBER_IDLE_TTL_SECONDS=2592000
ADMIN_AUTH_REMEMBER_COOKIE_NAME=task_mall_admin_refresh
ADMIN_AUTH_MAX_ACTIVE_SESSIONS=3
ADMIN_AUTH_FAILURE_THRESHOLD=5
ADMIN_AUTH_FAILURE_WINDOW_SECONDS=900
ADMIN_AUTH_LOCK_SECONDS=900
ADMIN_AUTH_RECENT_VERIFICATION_SECONDS=900
PHONE_VERIFICATION_DRIVER=log
PHONE_VERIFICATION_TTL_SECONDS=300
PHONE_VERIFICATION_DEV_CODE=246810
PHONE_VERIFICATION_MAX_ATTEMPTS=5
PHONE_VERIFICATION_RESEND_SECONDS=60
PHONE_VERIFICATION_HOURLY_LIMIT=5
PHONE_VERIFICATION_DAILY_LIMIT=10
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
