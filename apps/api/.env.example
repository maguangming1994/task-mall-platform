XP_BASE_URL=https://xp.vvbot.cc
XP_API_KEY=
XP_TIMEOUT_SECONDS=35
# 发帖机器人 AI 内容生成（OpenAI 兼容接口），留空则只能使用帖子池/历史帖子
ROBOT_AI_BASE_URL=
ROBOT_AI_API_KEY=
ROBOT_AI_MODEL=
# 社区内容安全：未配置时可在管理后台保存（数据库加密存储），二者都为空则阿里云检测降级跳过
GREEN_ACCESS_KEY_ID=
GREEN_ACCESS_KEY_SECRET=
PAYOUT_DRIVER=local
PAYOUT_ENDPOINT=
PAYOUT_SECRET=
PAYOUT_CALLBACK_URL=
