# 文本文件统一使用 LF，避免跨平台产生整文件行尾差异
* text=auto eol=lf

# Windows 批处理脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件禁止行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
